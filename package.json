{
  "name": "niarim-web",
  "version": "1.0.0",
  "private": true,
  "description": "NIARIM 公式サイト（Cloudflare Workers Static Assets + Worker）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "audit": "node tools/audit-site.js",
    "audit:browser": "node tests/autonomous-browser-audit.mjs",
    "audit:multilang": "node tests/multilang-responsive-audit-v2.mjs",
    "audit:i18n": "node tests/i18n-completeness-audit.mjs",
    "audit:visual-final": "node tests/final-visual-invariants-audit.mjs",
    "audit:visual-screenshots": "node tests/final-visual-screenshot-audit.mjs",
    "audit:mock-detail": "node tests/mock-detail-audit.mjs",
    "audit:style-source": "node tests/source-style-consistency-audit.mjs",
    "audit:all": "npm run audit && npm run audit:browser && npm run audit:multilang && npm run audit:i18n && npm run audit:visual-final && npm run audit:visual-screenshots && npm run audit:mock-detail && npm run audit:style-source",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "wrangler": "^4.126.0"
  }
}
