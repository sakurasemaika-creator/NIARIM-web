{
  "name": "niarim-web",
  "version": "1.0.0",
  "private": true,
  "description": "NIARIM 公式サイト（Cloudflare Workers Static Assets + Worker）",
  "scripts": {
    "dev": "node tools/start-dev.mjs",
    "verify:env": "node tools/verify-env.mjs",
    "shot": "node tools/shot.mjs",
    "deploy": "wrangler deploy",
    "audit": "node tools/audit-site.js",
    "audit:browser": "node tests/autonomous-browser-audit-v2.mjs",
    "audit:multilang": "node tests/multilang-responsive-audit-v4.mjs",
    "audit:intermediate-widths": "node tests/intermediate-width-home-audit.mjs && AUDIT_PAGES=/ AUDIT_WIDTHS=320,339,360,375,390,414,480,520,543,559,560,600,640,641,642,700,732,733,759,760,768,834,900,901,1023,1024,1100,1199,1200,1279,1280,1366,1440,1600,1920 node tests/modern-width-visual-audit.mjs",
    "audit:i18n": "node tests/i18n-completeness-audit.mjs",
    "audit:visual-final": "node tests/final-visual-invariants-audit-v2.mjs",
    "audit:visual-screenshots": "node tests/final-visual-screenshot-audit-v3.mjs",
    "audit:mock-detail": "node tests/mock-detail-audit.mjs",
    "audit:style-source": "node tests/source-style-consistency-audit.mjs",
    "audit:all": "npm run audit && npm run audit:browser && npm run audit:multilang && npm run audit:intermediate-widths && npm run audit:i18n && npm run audit:visual-final && npm run audit:visual-screenshots && npm run audit:mock-detail && npm run audit:style-source && npm run audit:font-capture && npm run audit:opal && npm run audit:heading-font",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "audit:font-capture": "node tests/font-and-captures-contract.mjs",
    "audit:brand-direction": "node tests/brand-direction-contract.mjs",
    "audit:opal": "node tests/opal-brand-contract.mjs",
    "audit:heading-font": "node tests/heading-font-cmap-audit.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "wrangler": "^4.126.0"
  }
}
