{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niarim-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "build": {
    "command": "node tools/generate-seo-i18n.mjs && node tools/build-css.mjs && node tools/build-js.mjs",
    "watch_dir": ["public/js", "public/css", "tools"],
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // HTML・API・404は従来どおりWorkerを通す一方、CSS/JS/画像/フォントは
    // Static Assetsから直接返す。例外パターンは通常パターンより優先される。
    "run_worker_first": ["/*", "!/assets/*", "!/css/*", "!/js/*"],
    // 未一致パスは public/404.html を404ステータスで返す
    // (未指定だと本文が空のまま404が返り、ブランドに沿った404ページが表示されない)
    "not_found_handling": "404-page",
  },
  // 公開サイトの正規URL（所有者の決定 2026-11-13：niarim.miranima-studio.com）。
  // 旧い Workers の既定のホストで開かれたページはここへ恒久転送する（src/canonical-host.js）。
  "vars": {
    "SITE_ORIGIN": "https://niarim.miranima-studio.com",
    // AWS Lambda Function URL for public community reads and verified account deletion.
    "NIARIM_PUBLIC_API_BASE_URL": "https://ibjfhyoqvfanle62ltokgz6sry0fjqfh.lambda-url.ap-northeast-1.on.aws/",
    "CONTACT_SITE_ORIGIN": "https://niarim.miranima-studio.com",
    "CONTACT_TO_EMAIL": "support@miranima-studio.com",
    "CONTACT_FROM_EMAIL": "NIARIM <support@miranima-studio.com>",
    // Public OAuth Web client ID shared with the backend's GOOGLE_CLIENT_ID,
    // for the Google sign-in on /account-deletion/ and /admin/.
    "ACCOUNT_DELETION_GOOGLE_CLIENT_ID": "673224289740-2dq86sb7504i055sng98fmdsp0qaimbo.apps.googleusercontent.com",
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONTACT_RATE_LIMITER", "class_name": "ContactRateLimiter" },
    ],
  },
  "migrations": [
    {
      "tag": "contact-rate-limiter-v1",
      "new_sqlite_classes": ["ContactRateLimiter"],
    },
  ],
  // RESEND_API_KEY は `npx wrangler secret put RESEND_API_KEY` で設定すること（本ファイルには書かない）。
}
