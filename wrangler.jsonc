{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niarim-web",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "build": {
    "command": "node tools/generate-seo-i18n.mjs",
    "watch_dir": ["public/js", "tools"],
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // HTMLもWorkerを通し、canonical/OG等を実際の公開URLへ正規化する。
    "run_worker_first": true,
    // 未一致パスは public/404.html を404ステータスで返す
    // (未指定だと本文が空のまま404が返り、ブランドに沿った404ページが表示されない)
    "not_found_handling": "404-page",
  },
  // 公開サイトの正規URL。独自ドメインへ移行した際はこの1か所を変更する。
  "vars": {
    "SITE_ORIGIN": "https://niarim-web.niarim.workers.dev",
    "CONTACT_TO_EMAIL": "your-inbox@example.com",
    "CONTACT_FROM_EMAIL": "NIARIM <noreply@niarim.example.com>",
  },
  // RESEND_API_KEY は `npx wrangler secret put RESEND_API_KEY` で設定すること（本ファイルには書かない）。
  // レート制限用のKV Namespaceを作成した場合は、以下のように kv_namespaces を追加する。
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }
  // ]
}
