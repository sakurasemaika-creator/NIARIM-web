# ==========================================================================
# NIARIM公式サイト 静的アセットのレスポンスヘッダー
#
# HTML/SEO/APIだけWorkerを先に通し、CSS/JS/画像/フォントはStatic Assetsから
# 直接返す。Worker側でもHTML/APIには同等のセキュリティヘッダーを付与する。
# ==========================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests

# フォント・アイコン・画像は内容が変わることがほとんどなく、変わるときは
# ファイル名ごと差し替える運用のため長めにキャッシュする。
/assets/*
  Cache-Control: public, max-age=2592000

# CSS/JSはハッシュ付きファイル名ではないので長期immutableにはしない。
# 短いfresh期間とstale-while-revalidateを組み合わせ、通常のページ回遊では
# 再取得を避けつつ、デプロイ後の更新も長時間固定しない。
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
